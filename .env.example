# --- Gemini (LLM) ---
GEMINI_API_KEY=

# --- Snowflake (datos, vía MCP) ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USERNAME=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=

# --- MCP server (cómo el orquestador lo levanta) ---
# Ruta al build del servidor MCP; por defecto apunta al build local del monorepo.
MCP_SNOWFLAKE_SERVER_PATH=../mcp-snowflake/dist/index.js
