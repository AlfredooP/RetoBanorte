# ==============================================================================
# CONFIGURACIÓN DE ENTORNO - RETO BANORTE × TEC (UI GENERATIVA)
# ==============================================================================

# --- Gemini (LLM Central) ---
# Clave de API de Google Gemini (requerida para generación de UI y razonamiento).
GEMINI_API_KEY=your_gemini_api_key_here

# Modelo de Gemini a utilizar (opcional, por defecto: gemini-3.6-flash).
# Ejemplos: gemini-3.6-flash, gemini-2.5-flash, gemini-2.0-flash
GEMINI_MODEL=gemini-3.6-flash

# --- Snowflake (Fuente de datos financieros vía MCP) ---
# Requeridas para consultar tablas y transacciones reales.
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USERNAME=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=BANORTE_DB
SNOWFLAKE_SCHEMA=PUBLIC
# Rol opcional (dejar vacío si se usa el rol por defecto del usuario):
SNOWFLAKE_ROLE=ACCOUNTADMIN

# --- Servidor MCP (Model Context Protocol) ---
# Ruta al build compilado del servidor MCP.
# - Para ejecución local (npm run dev:web): ../mcp-snowflake/dist/index.js
# - Para Docker en producción: /app/packages/mcp-snowflake/dist/index.js
MCP_SNOWFLAKE_SERVER_PATH=/app/packages/mcp-snowflake/dist/index.js

# --- Configuración del Servidor Web (Next.js) ---
PORT=3000
NODE_ENV=production
